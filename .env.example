# Copy this file to .env before running.
# Never commit your real .env, private key, wallet address, logs, CSVs, or order state.

PYTHONIOENCODING=utf-8
PYTHONUNBUFFERED=1

# Runtime
POLY_RUN_ONCE=true
POLY_SCAN_LIMIT=200
# Gamma events usually rejects deep offsets around 10k. 50 pages keeps the broad scan below that boundary.
POLY_MAX_PAGES=50
POLY_SLEEP_SECONDS=300
POLY_SCAN_WORKERS=8
POLY_SCAN_PROGRESS_INTERVAL=25
POLY_VERBOSE=false

# Mode
# Keep false for dry-run/paper mode. Set true only after you understand the risks.
POLY_AUTO_ORDER=false
POLY_ONLY_TODAY=false

# Wallet / API - fill in locally only
POLY_PRIVATE_KEY=
POLY_FUNDER=
# Deposit-wallet accounts usually use 3. Older proxy/safe accounts may use 1/2.
POLY_SIGNATURE_TYPE=3
POLY_CHAIN_ID=137

# Optional CLOB API credentials from the same Polymarket account as POLY_FUNDER.
# Leave blank to let the client derive/create credentials automatically.
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# Files
POLY_LOG_CSV=csv/polymarket_temperature_signals.csv
POLY_CLV_REVIEW_CSV=csv/polymarket_temperature_clv_review.csv
POLY_SHADOW_TRADE_CSV=csv/polymarket_temperature_shadow_trades.csv
POLY_ORDER_STATE_JSON=csv/polymarket_temperature_order_state.json

# Bankroll / sizing
POLY_BANKROLL=40
POLY_MAX_TRADE_PCT=0.03
POLY_KELLY_FRACTION=0.25
POLY_LIVE_MIN_ORDER_SIZE=1.00
POLY_SKIP_SUB_MIN_ULTRA_LOW_ORDERS=true
# Allow only high-quality station-confirmed sub-min ideas to be raised to the $1 CLOB minimum.
# Keep this below recent station_metar winners (~0.79-0.81) but above weak/no-station noise.
POLY_SKIP_SUB_MIN_ORDERS=true
POLY_SUB_MIN_ORDER_MIN_SCORE=0.79
POLY_SUB_MIN_ORDER_MIN_PRICE=0.02
POLY_SUB_MIN_ORDER_MIN_RESOLUTION_SCORE=1.00
POLY_SKIP_PAST_TARGET_DATES=true
POLY_LIVE_DEFAULT_TICK_SIZE=0.001
POLY_LIVE_MAX_ORDERS_PER_SCAN=2
POLY_LIVE_MAX_DOLLARS_PER_SCAN=2.00
POLY_MAX_ORDERS_PER_CITY_DATE=1

# Take profit / stop loss
POLY_DAILY_TAKE_PROFIT_PCT=0.80
POLY_TAKE_PROFIT_CLOSE_ALL_ENABLED=false
POLY_TAKE_PROFIT_CLOSE_SAME_DAY_ONLY=false
POLY_DAILY_STOP_LOSS_PCT=0.50

# YES single-position take profit
POLY_YES_POSITION_TAKE_PROFIT_ENABLED=true
POLY_YES_TP_3X_MULTIPLE=5.0
POLY_YES_TP_5X_MULTIPLE=10.0
POLY_YES_TP_10X_MULTIPLE=15.0
POLY_YES_TP_3X_FRACTION=0.35
POLY_YES_TP_5X_FRACTION=0.35
POLY_YES_TP_10X_FRACTION=0.50
POLY_YES_TP_FULL_EXIT_PRICE=0.80
POLY_YES_TP_SPIKE_MODE_ENABLED=true
POLY_YES_TP_SPIKE_PRICE=0.20
POLY_YES_TP_SPIKE_MULTIPLE=5.0
POLY_YES_TP_SPIKE_FRACTION=0.80
POLY_YES_TP_SPIKE_FULL_PRICE=0.50
POLY_YES_TP_SPIKE_FULL_MULTIPLE=15.0
POLY_YES_TP_SAME_DAY_ONLY=false
# Disabled by default because it can submit real sell orders.
POLY_YES_TIME_DECAY_STOP_LOSS_ENABLED=false
POLY_YES_TIME_DECAY_STOP_LOSS_HOURS=4
POLY_YES_TIME_DECAY_STOP_LOSS_PCT=0.60
POLY_YES_TIME_DECAY_STOP_LOSS_MIN_BID=0.01

# Market filters
POLY_ALLOW_SIDE=YES
POLY_MIN_PRICE=0.02
POLY_MAX_PRICE=0.18
POLY_YES_MAX_PRICE=0.18
POLY_NO_MAX_PRICE=0.20
POLY_MIN_VOLUME=5000
POLY_MIN_DEPTH_MULTIPLIER=1.0

# YES: low-price asymmetric payoff mode
POLY_YES_MIN_EDGE=0.22
POLY_YES_MIN_EV=0.18
POLY_YES_MIN_SCORE=0.22
POLY_YES_EARLY_MAX_PRICE=0.08
POLY_YES_EARLY_SIZE_MULTIPLIER=0.70
POLY_YES_INTRADAY_ENABLED=true
POLY_YES_INTRADAY_CONFIRM_ABOVE_PRICE=0.05
POLY_YES_INTRADAY_CONFIRM_DISTANCE=0.80
POLY_YES_INTRADAY_MAX_DAYS_AHEAD=1
POLY_YES_LOW_PRICE_REQUIRE_CURRENT_METAR_CONFIRM=true
POLY_YES_LOW_PRICE_CURRENT_METAR_MAX_DISTANCE=0.80
POLY_YES_EXACT_ONLY_MODE=true
POLY_YES_SWEET_SPOT_MIN_PRICE=0.02
POLY_YES_SWEET_SPOT_MAX_PRICE=0.05
POLY_YES_SWEET_SPOT_MULTIPLIER=1.35
POLY_YES_ULTRA_LOW_MIN_PRICE=0.002
POLY_YES_ULTRA_LOW_MAX_PRICE=0.02
POLY_YES_ULTRA_LOW_SIZE_MULTIPLIER=0.20
# Keep adjacent sweep off by default. It previously promoted weak ultra-low
# baskets into real $1 orders. If manually enabled, keep it inside 2c-5c exact
# and block rows that failed confidence/distance/history/spread/station gates.
POLY_YES_ADJACENT_SWEEP_ENABLED=false
POLY_YES_ADJACENT_MIN_PRICE=0.02
POLY_YES_ADJACENT_MAX_PRICE=0.05
POLY_YES_ADJACENT_MIN_COUNT=2
POLY_YES_ADJACENT_MAX_STEP_C=1.20
POLY_YES_ADJACENT_MAX_DAYS_AHEAD=1
POLY_YES_ADJACENT_BLOCK_SOFT_FAILURES=true
POLY_YES_ADJACENT_REQUIRE_STATION=true
POLY_YES_ADJACENT_MIN_MODEL_PROB=0.55
POLY_YES_MID_PRICE_EXTRA_EDGE=0.06
POLY_YES_MID_PRICE_EXTRA_EV=0.08
POLY_YES_MID_PRICE_SIZE_MULTIPLIER=0.55
POLY_YES_STRONG_CONFIRM_MIN_PRICE=0.08
POLY_YES_STRONG_CONFIRM_MAX_PRICE=0.10
POLY_YES_STRONG_CONFIRM_EXTRA_EDGE=0.10
POLY_YES_STRONG_CONFIRM_EXTRA_EV=0.12
POLY_YES_STRONG_CONFIRM_MIN_CONFIDENCE=0.78
POLY_YES_STRONG_CONFIRM_SIZE_MULTIPLIER=0.30
POLY_YES_HIGH_PRICE_HARD_CAP=0.10
POLY_YES_HIGH_PRICE_EXCEPTION_MAX=0.18
POLY_YES_HIGH_PRICE_EXCEPTION_DISTANCE=0.35
POLY_YES_HIGH_PRICE_EXTRA_EDGE=0.18
POLY_YES_HIGH_PRICE_EXTRA_EV=0.25
POLY_YES_HIGH_PRICE_MIN_CONFIDENCE=0.84
POLY_YES_HIGH_PRICE_EXCEPTION_SIZE_MULTIPLIER=0.15

# Intraday METAR / station calibration / snapshots
POLY_METAR_ENABLED=true
POLY_RESOLUTION_SOURCE_REQUIRED_ABOVE_PRICE=0.05
POLY_RESOLUTION_NO_STATION_SIZE_MULTIPLIER=0.20
POLY_RESOLUTION_NO_METAR_SIZE_MULTIPLIER=0.70
POLY_RESOLUTION_VERIFIED_SIZE_MULTIPLIER=1.10
POLY_RESOLUTION_NO_STATION_EXTRA_EDGE=0.06
POLY_RESOLUTION_NO_STATION_EXTRA_EV=0.08
POLY_RESOLUTION_NO_METAR_EXTRA_EDGE=0.03
POLY_RESOLUTION_NO_METAR_EXTRA_EV=0.04
POLY_NO_METAR_BLOCK_DISTANCE=0.80
POLY_NO_METAR_RISK_DISTANCE=1.20
POLY_STATION_CALIBRATION_ENABLED=true
POLY_STATION_CALIBRATION_JSON=csv\station_calibration.json
POLY_STATION_CALIBRATION_MIN_SAMPLES=8
POLY_STATION_CALIBRATION_MAX_ABS_SHIFT=0.06
POLY_SNAPSHOT_ENABLED=true
POLY_SNAPSHOT_DIR=csv\snapshots

POLY_YES_EXACT_EXTRA_EDGE=0.16
POLY_YES_EXACT_EXTRA_EV=0.12
POLY_YES_EXACT_MIN_CONFIDENCE=0.68
POLY_YES_EXACT_MIN_PRICE=0.02
POLY_YES_EXACT_MAX_DAYS_AHEAD=1
POLY_YES_EXACT_MAX_FORECAST_DISTANCE=0.80
POLY_YES_EXACT_MAX_HISTORY_GAP=0.16
POLY_YES_EXACT_MIN_HISTORY_PROB=0.12
POLY_YES_EXACT_MAX_HISTORY_MEAN_DISTANCE=1.20
POLY_YES_ABOVE_MIN_HISTORY_PROB=0.30
POLY_YES_EXACT_SIGNAL_MULTIPLIER=0.45
POLY_YES_PRIORITY_CITIES=Miami,Shanghai
POLY_YES_PRIORITY_EDGE_DISCOUNT=0.00
POLY_YES_PRIORITY_EV_DISCOUNT=0.00
POLY_YES_PRIORITY_SIZE_MULTIPLIER=1.00
POLY_YES_CITY_BLACKLIST=Seoul,Wuhan,Chongqing,Tel Aviv,Ankara,Paris,Warsaw,Milan,Beijing,Hong Kong,Jakarta,Busan,Shenzhen,Madrid,Chicago,Seattle

# NO: confirmation-oriented mode
POLY_NO_MIN_EDGE=0.20
POLY_NO_MIN_EV=0.35
POLY_NO_MIN_SCORE=0.20
POLY_NO_MAX_DAYS_AHEAD=0
POLY_NO_SIZE_MULTIPLIER=0.25
POLY_NO_EXACT_MIN_FORECAST_DISTANCE=1.40
POLY_NO_EXACT_MIN_HISTORY_NO_PROB=0.84
POLY_NO_TIERED_SIZING_ENABLED=true
POLY_NO_TIER_MID_PROB=0.76
POLY_NO_TIER_MID_EDGE=0.24
POLY_NO_TIER_MID_EV=0.35
POLY_NO_TIER_MID_MULTIPLIER=0.75
POLY_NO_TIER_HIGH_PROB=0.82
POLY_NO_TIER_HIGH_EDGE=0.32
POLY_NO_TIER_HIGH_EV=0.60
POLY_NO_TIER_HIGH_MULTIPLIER=1.10
POLY_NO_TIER_ELITE_PROB=0.88
POLY_NO_TIER_ELITE_EDGE=0.42
POLY_NO_TIER_ELITE_EV=0.90
POLY_NO_TIER_ELITE_MULTIPLIER=1.45
POLY_NO_TIER_MIN_FORECAST_DISTANCE=1.40
POLY_NO_TIER_MIN_HISTORY_NO_PROB=0.82

# No-station risk controls
# false blocks NO trades when Polymarket does not expose a clear station code.
POLY_NO_STATION_ENABLED=false
POLY_NO_STATION_MIN_EDGE=0.30
POLY_NO_STATION_MIN_EV=0.60
POLY_NO_STATION_MIN_SCORE=0.20
POLY_NO_STATION_MIN_FORECAST_DISTANCE=1.80
POLY_NO_STATION_MIN_HISTORY_NO_PROB=0.84
POLY_NO_STATION_SIZE_MULTIPLIER=0.35
# YES no-station trades are not part of the main book. Keep them rare, tiny,
# and do not let mispricing mode bypass history/distance checks.
POLY_YES_NO_STATION_MAX_PRICE=0.02
POLY_YES_NO_STATION_MIN_HISTORY_PROB=0.30
POLY_YES_NO_STATION_MAX_FORECAST_DISTANCE=0.60
POLY_YES_NO_STATION_SIZE_MULTIPLIER=0.10
POLY_YES_NO_STATION_ALLOW_MISPRICING_OVERRIDE=false

# Model
POLY_TEMP_BAND_C=2
POLY_FORECAST_PROBABILITY_MODEL=normal
POLY_FORECAST_MAE_C=1.50
POLY_FORECAST_EXACT_BAND_C=0.50
POLY_STATION_MAE_CALIBRATION_ENABLED=true
POLY_STATION_MAE_AUTO_UPDATE_ENABLED=true
POLY_STATION_MAE_CALIBRATION_JSON=csv\station_mae_calibration.json
POLY_STATION_MAE_LOOKBACK_DAYS=90
POLY_STATION_MAE_MIN_SAMPLES=30
POLY_STATION_MAE_STALE_DAYS=7
POLY_STATION_MAE_MAX_REFRESHES_PER_SCAN=20
POLY_PROBABILITY_SHRINK=0.70
POLY_HISTORY_ENABLED=true
POLY_HISTORY_DISK_CACHE_ENABLED=true
POLY_HISTORY_CACHE_DIR=cache\history
POLY_HISTORY_WEIGHT=0.30
POLY_HISTORY_LOOKBACK_YEARS=5
POLY_HISTORY_WINDOW_DAYS=15
POLY_ENSEMBLE_ENABLED=true
POLY_ENSEMBLE_MODELS=ecmwf_ifs04,gfs_seamless,icon_seamless
POLY_ENSEMBLE_MODEL_WEIGHTS=ecmwf_ifs04:0.50,gfs_seamless:0.25,icon_seamless:0.25
POLY_ENSEMBLE_MIN_MEMBERS=8
POLY_ENSEMBLE_WEIGHT=0.75

# Weather station alignment
# The bot extracts Weather Underground station codes from Polymarket resolutionSource
# when available, for example KSFO/KLAX/RKSI/RPLL, and uses station coordinates first.

# EV / score / sizing
POLY_NET_EV_SPREAD_WEIGHT=0.50
POLY_NET_EV_LOW_PRICE_CUTOFF=0.08
POLY_NET_EV_LOW_PRICE_PENALTY=0.01
POLY_EXACT_COST_PENALTY=0.03
POLY_SCORE_EDGE_WEIGHT=0.40
POLY_SCORE_EV_WEIGHT=0.45
POLY_SCORE_SPREAD_WEIGHT=0.20
POLY_SCORE_DEPTH_WEIGHT=0.01
POLY_EXIT_MAX_SPREAD=0.05
POLY_EXIT_MIN_BID_DEPTH_MULTIPLIER=1.00
POLY_LATE_ENTRY_CONFIRM_ENABLED=true
POLY_LATE_ENTRY_HOURS=4
POLY_LATE_ENTRY_MAX_SPREAD=0.03
POLY_LATE_ENTRY_LAST_HOUR_MAX_SPREAD=0.04
POLY_LATE_ENTRY_MAX_THRESHOLD_DISTANCE=0.60
POLY_HISTORY_GAP_REDUCE=0.18
POLY_HISTORY_GAP_HARD_CAP=0.25
POLY_STRONG_SIGNAL_EDGE=0.24
POLY_STRONG_SIGNAL_EV=0.35
POLY_STRONG_SIGNAL_CONFIDENCE=0.72
POLY_MAX_SIGNAL_MULTIPLIER=1.80
POLY_WEAK_SIGNAL_MULTIPLIER=0.50
POLY_EXACT_SIGNAL_MULTIPLIER=0.80
